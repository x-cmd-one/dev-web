# shellcheck shell=dash

(
    # Section: Arg
    RELEASE_SCOPE="${1:-all}"
    case "$RELEASE_SCOPE" in
        all|main|install|pkg|blog) ;;
        *) printf '%s\n' "Usage: x ws release all|main|install|pkg|blog" >&2; return 1 ;;
    esac
    WORK_DIR="$(x wsroot)"
    owner_repo=x-cmd/official-doc
    ref=main

    # Section: Main
    [ -n "$github_token" ] || {
        printf "%s\n" "Error Token"
        exit 1
    }
    export GH_TOKEN="$github_token"
    command gh auth setup-git --hostname github.com || return 1
    x gh --cfg set token="${github_token}"
    command gh repo clone --no-upstream \
        "https://github.com/${owner_repo}.git" "$WORK_DIR/.x-cmd/webapp" -- --branch "$ref" || exit 1
    x cd "$WORK_DIR/.x-cmd/webapp"|| exit 1
    echo "
BAIDU_TOKEN=${BAIDU_TOKEN}
BING_TOKEN=${BING_TOKEN}
UMAMI_ENDPOINT=${UMAMI_ENDPOINT}
BAIDU_TONGJI_EN_ID=${BAIDU_TONGJI_EN_ID}
BAIDU_TONGJI_CN_ID=${BAIDU_TONGJI_CN_ID}
UMAMI_EN_ID=${UMAMI_EN_ID}
UMAMI_CN_ID=${UMAMI_CN_ID}
UMAMI_HK_ID=${UMAMI_HK_ID}
"   > "$WORK_DIR/.x-cmd/webapp/.env"

    x ws release "$RELEASE_SCOPE"
)
